# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Model Settings
MODEL_NAME=gpt-3.5-turbo
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=1024

# Optimization Settings
METRIC_THRESHOLD=0.7
MAX_ITERATIONS=10

# Logging
VERBOSE=true

# Flowise Integration
FLOWISE_URL=http://localhost:3000
FLOWISE_CHATFLOW_ID=your-chatflow-id
FLOWISE_API_KEY=

# Webhook Server
FLOWISE_WEBHOOK_ENABLED=false
FLOWISE_WEBHOOK_HOST=0.0.0.0
FLOWISE_WEBHOOK_PORT=5000
FLOWISE_WEBHOOK_PATH=/webhook/flowise
FLOWISE_WEBHOOK_SECRET=

# Batch Processing
FLOWISE_POLLING_INTERVAL=60
FLOWISE_BATCH_SIZE=10
